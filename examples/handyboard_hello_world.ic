void main()
{
    printf("Hello World!\n");
    beep();
    sleep(1.0);
    
    printf("Press START...\n");
    start_press();
    
    while (!stop_button()) {
        printf("Hello World!\nKnob: %d\n", knob());
        sleep(0.3);
    }
    
    printf("Goodbye!\n");
    beep();
}
