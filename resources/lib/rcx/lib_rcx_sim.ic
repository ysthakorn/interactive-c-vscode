#use "libsim.ic"

/* Sensor Defines */

#define SENSORTYPE_RAW         0
#define SENSORTYPE_TOUCH       1
#define SENSORTYPE_TEMP        2
#define SENSORTYPE_LIGHT       3
#define SENSORTYPE_ROTATION    4

#define SENSORMODE_RAW        0x00
#define SENSORMODE_BOOL       0x20
#define SENSORMODE_EDGE       0x40
#define SENSORMODE_PULSE      0x60
#define SENSORMODE_PERCENT    0x80
#define SENSORMODE_DEGREEC    0xa0
#define SENSORMODE_DEGREEF    0xc0
#define SENSORMODE_ANGLE      0xe0

#define SensorPassive(x) setsensoractivity(x,0)
#define SensorActive(x)  setsensoractivity(x,1)

// These are bad.  Don't uncomment.
//#define pressure(x)  light_passive(x)
//#define analog(x)    light(x)


int pressure ( int x){
	return light_passive(x);   
}

int analog (int x) {
  return light(x);  
}

