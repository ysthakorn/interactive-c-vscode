# Not worth templatizing
lib   beeper_on
lib   beeper_off
lib   set_beeper_pitch

lib   fd
doc   fd fd(int: motor 0-3)      Turn motor on in "forwards" direction

lib   bk
doc   bk bk(int: motor 0-3)      Turn motor on in "forwards" direction

lib   off
doc   off off(int: motor 0-3)      Turn motor off

lib   brake
doc   brake brake(...)    THIS FUNCTION DOES NOT EXIST FOR THE HANDYBOARD

lib   alloff
doc   alloff alloff()      Turn all motors off

lib   ao
doc   ao ao()      Turn all motors off

lib   motor
doc   motor motor(int: motor 0 to 3, int: speed -100 to 100)      Turn motor on at given speed

lib   stop_button
doc   stop_button stop_button()      Return 1 if stop_button is pressed

lib   start_button
doc   start_button start_button()      Return 1 if start_button is pressed

lib   knob
doc   knob knob()      Returns current position of knob, 0 to 255

lib   hog_processor
doc   hog_processor hog_processor()     Keep from switching to another process

lib   defer
doc   defer defer()      Switch to another process now

lib	start_process
doc 	start_process(function)      Start a new process.

lib	defer
doc	kill_process(int: pid)      Kill process # pid (pid is returned by start_process)

lib   random
doc   random(int: num)      Return a random number between 0 and num-1, inclusive

lib   printf
doc   printf printf(string: "format", args...)      Print to the LCD.  \
                               Examples: printf("Hello\n");  \
                               printf("analog(3) is %d\n", analog(3));

lib   servo0
doc   servo0 int servo0:  Set this variable to control servo 0. \
			(Must call init_expbd_servos first)
lib   servo1
doc   servo1 int servo1:  Set this variable to control servo 1. \
			(Must call init_expbd_servos first)
lib   servo2
doc   servo2 int servo2:  Set this variable to control servo 2. \
			(Must call init_expbd_servos first)
lib   servo3
doc   servo3 int servo3:  Set this variable to control servo 3. \
			(Must call init_expbd_servos first)
lib   servo4
doc   servo4 int servo4:  Set this variable to control servo 4. \
			(Must call init_expbd_servos first)
lib   servo5
doc   servo5 int servo5:  Set this variable to control servo 5. \
			(Must call init_expbd_servos first)

lib   init_expbd_servos
doc   init_expbd_servos init_expbd_servos(int action)      Enable expansion \
					board servos if \
                                        action=1.  Disable expansion board \
                                        servos if action=0.

lib   sonar
doc   sonar int sonar()      Fires sonar and reports approximate distance in \
                   millimeters.  32767 means no echo detected.

